+                offset - s.PointerToRawData > s.SizeOfRawData - size) continue;
+            auto* dest = base + s.VirtualAddress + offset - s.PointerToRawData;
+            if (std::memcmp(dest, &old, size) != 0) valid = false;
+            edits.push_back({dest, value, size});
+            return;
+        }
+        valid = false;
+    };
+    constexpr unsigned widths[] = {1920,2432,2432,3328,3840};
+    constexpr unsigned heights[] = {1080,1368,1368,1872,2160};

+void StreamBuffer::RetainSince(uint64_t preparation_tick) {
+	const auto tick = Scheduler().CurrentTick();
+	if (preparation_tick >= tick) return;
+	static const bool enabled = [] {
+		const auto* value = std::getenv("KYTY_STREAM_RETAIN");
+		return value == nullptr || std::strcmp(value, "0") != 0;
+	}();
+	if (!enabled) return;
+	const auto retain = [preparation_tick, tick](std::vector<Watch>& watches, size_t count) {
+		bool changed = false;
+		for (size_t i = 0; i < count; ++i) {
+			if (watches[i].tick >= preparation_tick && watches[i].tick < tick) {
+				watches[i].tick = tick;
+				changed = true;
+			}
+		}
+		return changed;
+	};
+	const bool current_changed = retain(m_current_watches, m_current_watch_cursor);
+	const bool previous_changed =
+	    m_invalidation_mark && retain(m_previous_watches, *m_invalidation_mark);
+	if (previous_changed) {
+		// A wrap may already have observed the old tick as complete. That cached
+		// verdict must be checked again after extending the reservation's lifetime.
+		m_wait_cursor = 0;
+		m_wait_bound = 0;
+	}
+	if (current_changed || previous_changed) {
+		static const bool log = [] {
+			const auto* value = std::getenv("KYTY_STREAM_RETAIN_LOG");
+			return value != nullptr && std::strcmp(value, "1") == 0;
+		}();
+		if (log) {
+			static std::atomic<uint64_t> count {0};
+			const auto n = count.fetch_add(1, std::memory_order_relaxed) + 1;
+			if (n <= 4 || (n & (n - 1)) == 0) {
+				std::printf("Stream retention: %llu preparations crossed submissions (tick %llu -> %llu)\n",
+				            static_cast<unsigned long long>(n),
+				            static_cast<unsigned long long>(preparation_tick),
+				            static_cast<unsigned long long>(tick));
+			}
+		}
+	}
+}

+void ComputePairedBindingPlan(const BindingPlanContext& context, const RegisterSnapshot& registers,
+                             const DrawIndexArgs* index_args, const PreparedDraw& prepared,
+                             const BindingPlan& shared, BindingPlan& plan) {
+	if (!shared.valid) {
+		ComputeBindingPlan(context, registers, index_args, prepared, plan);
+		return;
+	}
+	// Own the vectors: each executor consumes/swaps its shader-data storage. Keep
+	// the original VM generation so a mapping change invalidates both certificates.
+	plan = shared;
+	plan.pipeline = nullptr;
+	plan.pipeline_generation = 0;
+	const auto local_stage = [&](const CompiledShaderInfo& program, const ResourceSnapshot& data,
+	                             StagePlan& stage) {
+		stage.samplers_valid = false;
+		stage.samplers.clear();
+		stage.texture_tags_valid = false;
+		stage.texture_tags.clear();
+		if (BindingPartEnabled(plan.parts, BindingPart::Samplers)) {
+			stage.samplers_valid = PlanSamplers(*context.samplers, program, data, stage);
+		}
+		if (BindingPartEnabled(plan.parts, BindingPart::TextureMemo) &&
+		    context.texture_memo != nullptr && TextureBindingMemo::Enabled()) {
+			stage.texture_hashes_valid = PlanTextureHashes(program, data, context.texture_memo, stage);
+			stage.texture_tags_valid &= stage.texture_hashes_valid;
+		}
+	};
+	local_stage(*prepared.vertex_info.stage.program, prepared.vertex_prep.resources, plan.vertex);
+	if (prepared.pixel_active) {
+		local_stage(*prepared.pixel_info.stage.program, prepared.pixel_prep.resources, plan.pixel);
+	}
+	if (BindingPartEnabled(plan.parts, BindingPart::Pipeline)) {
+		PlanPipeline(context, registers, index_args, prepared, plan);
+	}
+	Profiler::CountFrameEvent(Profiler::FrameEvent::DrawPrepBindingPlans);
+}

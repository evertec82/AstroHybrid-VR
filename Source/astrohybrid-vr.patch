diff --git a/src/common/frameStep.h b/src/common/frameStep.h
new file mode 100644
index 00000000..349e4839
--- /dev/null
+++ b/src/common/frameStep.h
@@ -0,0 +1,25 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace Common {
+// A simulation interval, not an OS clock. A debugger pause/loading stall resets the sample
+// rather than making the simulation catch up in one giant physics step.
+class FrameStepClock {
+public:
+	double Advance(uint64_t now_ns, double nominal, bool realtime) {
+		if (!std::isfinite(nominal) || nominal <= 0 || nominal > 0.1) nominal = 1.0 / 60.0;
+		const auto previous = last_ns;
+		last_ns = now_ns;
+		if (!realtime || previous == 0 || now_ns <= previous) return nominal;
+		const double elapsed = double(now_ns - previous) * 1e-9;
+		if (elapsed > 0.25) return nominal;
+		// Preserve short frames too: rounding each one up accumulates positive clock drift.
+		return std::clamp(elapsed, 0.001, 0.1);
+	}
+private:
+	uint64_t last_ns = 0;
+};
+} // namespace Common

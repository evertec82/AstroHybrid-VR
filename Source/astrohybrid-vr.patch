+    for(auto p:{0x739541a,0x7397ca7}) add(p,3840,width);
+    for(auto p:{0x739540e,0x7397cb6,0x73af406}) add(p,1368,height);
+    for(auto p:{0x73953ee,0x7397cb1,0x73af414}) add(p,2160,height);
+    for(auto p:{0x2c2ded,0x745de71,0x73ddf9d}) { add(p,3840,width); add(p+4,2160,height); }

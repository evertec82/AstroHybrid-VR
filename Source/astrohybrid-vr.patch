+inline bool IsCommittedReadable(uintptr_t addr, size_t len) {
+	MEMORY_BASIC_INFORMATION mbi {};
+	if (VirtualQuery(reinterpret_cast<const void*>(addr), &mbi, sizeof(mbi)) != sizeof(mbi)) {
+		return false;
+	}
+	if (mbi.State != MEM_COMMIT || (mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) != 0) {
+		return false;
+	}
+	const uintptr_t region_end = reinterpret_cast<uintptr_t>(mbi.BaseAddress) + mbi.RegionSize;
+	return addr + len <= region_end;
+}
+
+inline bool WriteProtectedBytes(uintptr_t addr, const uint8_t* bytes, size_t len) {
+	DWORD old_protect = 0;
+	if (!VirtualProtect(reinterpret_cast<void*>(addr), len, PAGE_EXECUTE_READWRITE, &old_protect)) {
+		return false;
+	}
+	std::memcpy(reinterpret_cast<void*>(addr), bytes, len);
+	DWORD dummy = 0;
+	VirtualProtect(reinterpret_cast<void*>(addr), len, old_protect, &dummy);
+	FlushInstructionCache(GetCurrentProcess(), reinterpret_cast<void*>(addr), len);
+	return true;
+}
+
+inline uint8_t* AllocNearTrampoline(uintptr_t base, bool& in_elf_slack) {
+	in_elf_slack = false;
+	// First search for any MEM_FREE region within +/-2 GiB of .elf0 (base .. base + 0x7800000).
+	const uintptr_t min_addr = 0x00010000ull;
+	const uintptr_t max_addr = base + 0x78000000ull;
+	uintptr_t       cursor   = min_addr;
+	while (cursor < max_addr) {
+		MEMORY_BASIC_INFORMATION mbi {};
+		if (VirtualQuery(reinterpret_cast<const void*>(cursor), &mbi, sizeof(mbi)) != sizeof(mbi)) {
+			break;
+		}
+		if (mbi.State == MEM_FREE && mbi.RegionSize >= 0x10000ull) {
+			const uintptr_t aligned = (reinterpret_cast<uintptr_t>(mbi.BaseAddress) + 0xFFFFull) & ~0xFFFFull;
+			const uintptr_t end     = reinterpret_cast<uintptr_t>(mbi.BaseAddress) + mbi.RegionSize;
+			if (aligned >= min_addr && aligned + 4096 <= end && aligned < max_addr) {
+				void* p = VirtualAlloc(reinterpret_cast<void*>(aligned), 4096,
+				                       MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
+				if (p != nullptr) {
+					return static_cast<uint8_t*>(p);
+				}
+			}
+		}
+		const uintptr_t next = reinterpret_cast<uintptr_t>(mbi.BaseAddress) + mbi.RegionSize;
+		if (next <= cursor) break;
+		cursor = next;
+	}
+	// Fallback: unused zero/INT3 page slack at the tail of .elf0 (RVA 0x74cd700, VSize=0x74be000 at RVA 0x10000 -> end 0x74ce000, RawSz=0x74bd600 -> raw end 0x74cd600).
+	const uintptr_t slack = base + 0x74cd700ull;
+	if (IsCommittedReadable(slack, 64)) {
+		const auto* bytes = reinterpret_cast<const uint8_t*>(slack);
+		bool        clean = true;
+		for (size_t i = 0; i < 64; ++i) {
+			if (bytes[i] != 0x00 && bytes[i] != 0xCC) {
+				clean = false;
+				break;
+			}
+		}
+		if (clean) {
+			in_elf_slack = true;
+			return reinterpret_cast<uint8_t*>(slack);
+		}
+	}
+	return nullptr;
+}
+
+inline uintptr_t EmitTrampoline(uint8_t*& cursor, const void* target_fn, bool protected_write) {
+	const uintptr_t slot = reinterpret_cast<uintptr_t>(cursor);
+	const uint64_t  addr = reinterpret_cast<uintptr_t>(target_fn);
+	uint8_t         code[16];
+	// movabs rax, imm64; jmp rax; int3; int3; int3; int3
+	code[0] = 0x48;
+	code[1] = 0xB8;
+	std::memcpy(code + 2, &addr, sizeof(addr));
+	code[10] = 0xFF;
+	code[11] = 0xE0;
+	code[12] = 0xCC;
+	code[13] = 0xCC;
+	code[14] = 0xCC;
+	code[15] = 0xCC;
+	if (protected_write) {
+		if (!WriteProtectedBytes(slot, code, sizeof(code))) return 0;
+	} else {
+		std::memcpy(cursor, code, sizeof(code));
+		FlushInstructionCache(GetCurrentProcess(), reinterpret_cast<void*>(slot), sizeof(code));
+	}
+	cursor += 16;
+	return slot;
+}
+
+inline bool PatchRel32(uintptr_t site, uint8_t expected_opcode, uintptr_t expected_target,
+                       uintptr_t new_target) {
+	if (!IsCommittedReadable(site, 5)) return false;
+	const auto* code = reinterpret_cast<const uint8_t*>(site);
+	if (code[0] != expected_opcode) return false;
+	int32_t old_rel = 0;
+	std::memcpy(&old_rel, code + 1, sizeof(old_rel));
+	if (static_cast<uintptr_t>(static_cast<intptr_t>(site + 5) + old_rel) != expected_target) {
+		return false;
+	}
+	const int64_t delta = static_cast<int64_t>(new_target) - static_cast<int64_t>(site + 5);
+	if (delta < INT32_MIN || delta > INT32_MAX) return false;
+	uint8_t patch[5];
+	patch[0] = expected_opcode;
+	const int32_t rel32 = static_cast<int32_t>(delta);
+	std::memcpy(patch + 1, &rel32, sizeof(rel32));
+	return WriteProtectedBytes(site, patch, sizeof(patch));
+}

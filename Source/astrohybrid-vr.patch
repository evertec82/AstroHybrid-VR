+	slot.tick = scheduler.CurrentTick();
+	slot.head = frame.pose.head;
+	slot.flat_fov = slot.eye_fovs[0];
+	slot.paired = true;
+	slot.flat_screen = frame.flat_screen;
+	slot.producer = &scheduler.GetMasterSemaphore();
+	slot.sequence = ++g.publication_sequence;
+	g.produced_pairs.fetch_add(1, std::memory_order_relaxed);
+	// Both copies and their pose/FOV metadata become visible together.
+	g.latest = index;
+	g.source_published.notify_one();
+	return true;

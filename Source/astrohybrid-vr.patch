+inline void __attribute__((sysv_abi))
+HookMainFrustum(const float* vp_ptr, float* out_planes, uint32_t* out_corners) {
+	CameraMatrix view {}, proj {}, vp {};
+	// At GfxRenderContext (0x7741f27): vp_ptr = r14 + 0x120, view = r14 + 0x00, proj = r14 + 0x80.
+	std::memcpy(view.data(), vp_ptr - 72, sizeof(view));
+	std::memcpy(proj.data(), vp_ptr - 40, sizeof(proj));
+	std::memcpy(vp.data(), vp_ptr, sizeof(vp));
+	CameraMatrix cull_vp {};
+	if (CameraNear(CameraMultiply(view, proj), vp, 0.01f) && BuildVrCullVp(view, proj, cull_vp)) {
+		const auto n = g_main_frustum_calls.fetch_add(1, std::memory_order_relaxed);
+		if (n == 0) {
+			std::printf("VR culling: main frustum hook active (proj[0]=%.3f proj[5]=%.3f proj[10]=%.5f proj[14]=%.5f)\n",
+			            proj[0], proj[5], proj[10], proj[14]);
+		}
+		g_orig_build_frustum(cull_vp.data(), out_planes, out_corners);
+		return;
+	}
+	g_orig_build_frustum(vp_ptr, out_planes, out_corners);
+}
+
+inline float ShadowCullScale() {
+	static const float scale = [] {
+		const char* v = std::getenv("KYTY_VR_SHADOW_CULL_SCALE");
+		if (!v || !*v) return 1.0f;
+		const float s = std::strtof(v, nullptr);
+		return std::isfinite(s) ? std::clamp(s, 0.50f, 1.00f) : 1.0f;
+	}();
+	return scale;
+}
+
+inline void __attribute__((sysv_abi))
+HookBatchCuller(uint8_t* culler, const float* view_ptr, const float* proj_ptr) {
+	// Run the original builder first so camera world position at [culler+0x140] stays exact.
+	g_orig_build_batch_culler(culler, view_ptr, proj_ptr);
+	CameraMatrix view {}, proj {}, cull_vp {};
+	std::memcpy(view.data(), view_ptr, sizeof(view));
+	std::memcpy(proj.data(), proj_ptr, sizeof(proj));
+	if (BuildVrCullVp(view, proj, cull_vp)) {
+		const auto n = g_batch_culler_calls.fetch_add(1, std::memory_order_relaxed);
+		if (n == 0) {
+			std::printf("VR culling: batch culler frustum hook active\n");
+		}
+		g_orig_build_frustum(cull_vp.data(), reinterpret_cast<float*>(culler + 0x150),
+		                     reinterpret_cast<uint32_t*>(culler + 0x1b0));
+	} else if (const float s = ShadowCullScale();
+	           s < 0.999f && std::abs(proj[11]) < 0.01f && std::abs(proj[15] - 1.0f) < 0.01f &&
+	           proj[0] > 0.0f && proj[5] > 0.0f) {
+		// Opt-in KYTY_VR_SHADOW_CULL_SCALE (< 1.0): tighten orthographic shadow-cascade batch
+		// frustum planes to cull far-edge shadow casters without affecting main-camera geometry.
+		proj[0] /= s;
+		proj[5] /= s;
+		const CameraMatrix shadow_vp = CameraMultiply(view, proj);
+		g_orig_build_frustum(shadow_vp.data(), reinterpret_cast<float*>(culler + 0x150),
+		                     reinterpret_cast<uint32_t*>(culler + 0x1b0));
+	}
+}
+
+inline void __attribute__((sysv_abi))
+HookCameraFrustum(const float* vp_ptr, float* out_planes, uint32_t* out_corners) {
+	CameraMatrix view {}, proj {}, vp {};
+	// At Camera::UpdateFrustum (0x13daf50/0x13dc180/0x13dc4be): vp = cam+0x100, view = cam+0x80, proj = cam+0xc0.
+	std::memcpy(view.data(), vp_ptr - 32, sizeof(view));
+	std::memcpy(proj.data(), vp_ptr - 16, sizeof(proj));
+	std::memcpy(vp.data(), vp_ptr, sizeof(vp));
+	CameraMatrix cull_vp {};
+	if (CameraNear(CameraMultiply(view, proj), vp, 0.01f) && BuildVrCullVp(view, proj, cull_vp)) {
+		const auto n = g_camera_frustum_calls.fetch_add(1, std::memory_order_relaxed);
+		if (n == 0) {
+			std::printf("VR culling: camera frustum hook active\n");
+		}
+		g_orig_build_frustum(cull_vp.data(), out_planes, out_corners);
+		return;
+	}
+	g_orig_build_frustum(vp_ptr, out_planes, out_corners);
+}

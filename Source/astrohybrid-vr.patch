diff --git a/tests/StereoStagingTests.cpp b/tests/StereoStagingTests.cpp
new file mode 100644
index 00000000..98f9b3a7
--- /dev/null
+++ b/tests/StereoStagingTests.cpp
@@ -0,0 +1,36 @@
+#include "graphics/presentation/stagingSelection.h"
+
+#include <cstdio>
+
+struct Timeline {
+	uint64_t completed;
+	bool IsFree(uint64_t tick) const { return tick <= completed; }
+};
+
+struct Slot {
+	uint64_t sequence = 0;
+	uint64_t tick = 0;
+	Timeline* producer = nullptr;
+};
+
+int main() {
+	using Libs::Vr::SelectSource;
+	using Libs::Vr::SelectWriteSlot;
+	Slot slots[3] {};
+	if (SelectSource(slots, -1, 0) != -1) return 1;
+	Timeline first {10}, second {1};
+	slots[0] = {1, 10, &first};
+	slots[1] = {2, 11, &first};
+	slots[2] = {3, 11, &first};
+	// A newer unfinished pair must not hide an intermediate completed pair.
+	if (SelectSource(slots, 2, 0) != 0 || SelectSource(slots, 1, 1) != 1) return 2;
+	if (SelectWriteSlot(slots, 2, 0) != 1 || SelectWriteSlot(slots, 0, -1) != 1) return 3;
+	first.completed = 11;
+	// Publication order also distinguishes two frames recorded at the same timeline tick.
+	if (SelectSource(slots, 1, 1) != 2 || SelectSource(slots, -1, 3) != -1) return 4;
+	slots[0] = {4, 2, &second};
+	if (SelectSource(slots, -1, 2) != 2) return 5;
+	second.completed = 2;
+	if (SelectSource(slots, -1, 2) != 0) return 6;
+	std::puts("Stereo staging selection passed");
+}
diff --git a/tests/VrRecenterTests.cpp b/tests/VrRecenterTests.cpp
new file mode 100644
index 00000000..3630e57e
--- /dev/null
+++ b/tests/VrRecenterTests.cpp
@@ -0,0 +1,50 @@
+#include "graphics/presentation/cameraTracking.h"
+#include "graphics/presentation/referenceRecenter.h"
+#include <cstdio>
+
+namespace Libs::Vr {
+VrFramePose sample;
+VrFramePose OpenXrGetFramePose() { return sample; }
+}
+
+int main() {
+	using namespace Libs::Vr;
+	const auto pose = [](float yaw, float x, uint64_t generation) {
+		VrFramePose p;
+		p.head = {true, {0, std::sin(yaw/2), 0, std::cos(yaw/2)}, {x, 0, 0}};
+		p.recenter_generation = generation;
+		return p;
+	};
+	const auto identity = [](const CameraMatrix& m) {
+		for (size_t i=0; i<m.size(); ++i)
+			if (std::abs(m[i] - (i%5 == 0 ? 1.f : 0.f)) > .0001f) return false;
+		return true;
+	};
+	const auto update = [&]() { AdvanceCameraFrame(); return CameraTrackingHeadTransform(); };
+	ReferenceRecenter timeline;
+	sample = pose(.4f, .2f, 0);
+	if (!identity(update())) return 1;
+	sample = pose(.8f, .6f, 0);
+	if (identity(update())) return 2;
+	// Receiving an event must not reset a camera sample from before changeTime.
+	timeline.Schedule(100);
+	if (timeline.Publish(99, true) != 0 || timeline.Publish(100, false) != 0) return 3;
+	if (identity(update())) return 4;
+	const auto generation = timeline.Publish(101, true);
+	if (generation != 1 || timeline.Publish(102, true) != generation) return 5;
+	// A renderer that already latched an older pose keeps the old generation, even if the
+	// headset thread has now published the new origin. Its next valid sample resets both
+	// orientation and position, and cancels the spurious previous-frame motion.
+	if (identity(update())) return 6;
+	sample = pose(.1f, 1.5f, generation);
+	if (!identity(update()) || !identity(camera_previous_head)) return 7;
+	sample = pose(.3f, 1.6f, generation);
+	if (identity(update())) return 8;
+	RequestRecenter();
+	if (!identity(update()) || !identity(camera_previous_head)) return 9;
+	// Separate future events must not get lost when the earlier one takes effect.
+	timeline.Schedule(200); timeline.Schedule(150);
+	if (timeline.Publish(175, true) != 2 || timeline.Publish(199, true) != 2 ||
+	    timeline.Publish(200, true) != 3) return 10;
+	std::puts("System recenter timing, latched poses, tracking reset, and F9 reset passed");
+}

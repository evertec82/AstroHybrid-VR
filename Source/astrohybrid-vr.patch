+		const auto& p = pose.eyes[eye].position;
+		const float depth = distance + p[2];
+		fovs[eye] = {std::atan((min_x - p[0]) / depth), std::atan((max_x - p[0]) / depth),
+		             std::atan((max_y - p[1]) / depth), std::atan((min_y - p[1]) / depth)};
+		EyeProjection lens;
+		if (!GetEyeProjection(fovs[eye], lens)) return false;
+	}
+	for (auto& eye: pose.eyes) {
+		eye.orientation[0] = eye.orientation[1] = eye.orientation[2] = 0;
+		eye.orientation[3] = 1;
+	}
+	pose.fovs = fovs;
+	return true;
+}
+
+// The renderer must additionally isolate temporal images, view-dependent GPU writes,
+// and their previous camera inputs. This helper alone does not enable stereo replay.
+inline std::optional<StereoFrame> PrepareStereoFrame(uint64_t id, const CameraBlock& source,
+                                                     const CameraMatrix& head_transform,
+                                                     const VrFramePose& pose,
+                                                     const CameraMatrix& previous_head = {},
+                                                     const VrFramePose& previous_pose = {},
+                                                     bool headset_projection = false) {
+	if (!ValidStereoPose(pose.head) || !ValidStereoPose(pose.eyes[0]) ||
+	    !ValidStereoPose(pose.eyes[1])) return std::nullopt;
+	StereoFrame frame;
+	frame.id = id;
+	frame.pose = pose;
+	std::array<EyeProjection, 2> lenses;
+	frame.headset_projection = headset_projection &&
+	    std::abs(source[40]) < 0.01f && std::abs(source[41]) < 0.01f &&
+	    GetEyeProjection(pose.fovs[0], lenses[0]) && GetEyeProjection(pose.fovs[1], lenses[1]);
+	for (size_t eye = 0; eye < 2; ++eye) {
+		frame.cameras[eye] = source;
+		const auto transform = CameraMultiply(head_transform, CameraEyeInverse(pose.eyes[eye]));
+		if (frame.headset_projection) {
+			const auto previous_transform = ValidStereoPose(previous_pose.eyes[eye])
+			    ? CameraMultiply(previous_head, CameraEyeInverse(previous_pose.eyes[eye])) : transform;
+			EyeProjection previous_lens;
+			const auto* prior = GetEyeProjection(previous_pose.fovs[eye], previous_lens)
+			    ? &previous_lens : &lenses[eye];
+			if (!RotateCameraBlock(frame.cameras[eye], transform, &previous_transform,
+			                       &lenses[eye], prior)) return std::nullopt;
+			frame.fovs[eye] = pose.fovs[eye];
+			continue;
+		}
+		if (!RotateCameraBlock(frame.cameras[eye], transform)) return std::nullopt;
+		const auto& camera = frame.cameras[eye];
+		const float sx = camera[32], sy = camera[37], ox = camera[40], oy = camera[41];
+		if (!(sx > 0 && sy > 0) || std::abs(ox) >= 1 || std::abs(oy) >= 1)
+			return std::nullopt;
+		frame.fovs[eye] = {std::atan((-1 + ox) / sx), std::atan((1 + ox) / sx),
+		                   std::atan((1 + oy) / sy), std::atan((-1 + oy) / sy)};
+	}
+	return frame;
+}
+
+} // namespace Libs::Vr

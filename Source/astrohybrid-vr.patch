+	    frame.headset_projection ? "headset projection" : "game projection";
+	if (last_source != left.extent || last_content != slot.content_extent ||
+	    last_mode != mode) {
+		last_source = left.extent;
+		last_content = slot.content_extent;
+		last_mode = mode;

+		if (found == hooks.registrations.end()) return 0;
+		registration = found->second;
+	}
+	// Never hold the registry mutex while trying the cache lock. Unregistration happens
+	// after this scheduler's recording/worker threads have stopped.
+	return registration.hook(registration.context, bytes);

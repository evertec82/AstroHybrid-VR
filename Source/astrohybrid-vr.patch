+inline void InstallVrCullingHooks() {
+	if (!FlatCameraVrEnabled()) return;
+	const char* env_fix = std::getenv("KYTY_VR_CULL_FIX");
+	if (env_fix != nullptr && std::strcmp(env_fix, "0") == 0) {
+		std::printf("VR culling: disabled by KYTY_VR_CULL_FIX=0\n");
+		return;
+	}
+	static std::atomic_bool installed {false};
+	if (installed.exchange(true)) return;
+
+	const auto base = reinterpret_cast<uintptr_t>(GetModuleHandleW(nullptr));
+	if (base == 0) return;
+
+	// Astro Bot PPSA21567 01.019.000 RVAs (verified across Gameplay4K-PhysicsGuard and DLSS-PhysicsGuard).
+	constexpr uintptr_t kRvaBuildFrustum      = 0x73793e0ull;
+	constexpr uintptr_t kRvaBuildBatchCuller  = 0x74b7de0ull;
+	constexpr uintptr_t kRvaMainFrustumCall   = 0x7351f27ull;
+	constexpr uintptr_t kRvaBatchCullerCall   = 0x7351f3eull;
+	constexpr uintptr_t kRvaCamFrustumJmp1    = 0x0feaf50ull;
+	constexpr uintptr_t kRvaCamFrustumJmp2    = 0x0fec180ull;
+	constexpr uintptr_t kRvaCamFrustumJmp3    = 0x0fec4beull;
+	constexpr uintptr_t kRvaIsCulledOccPlane  = 0x7379c60ull;
+	constexpr uintptr_t kRvaGpuOccCheckMain   = 0x746ffacull;
+	constexpr uintptr_t kRvaGpuOccCheckClouds = 0x73c1405ull;
+	constexpr uintptr_t kRvaDisplayWithCull   = 0x743e790ull;
+	constexpr uintptr_t kRvaDisplayNoCull     = 0x743e200ull;
+
+	static constexpr uint8_t kExpectedBuildFrustum[12] = {
+	    0x55, 0x48, 0x89, 0xe5, 0x53, 0x48, 0x81, 0xec, 0x88, 0x00, 0x00, 0x00};
+	static constexpr uint8_t kExpectedBuildBatch[9] = {
+	    0x55, 0x48, 0x89, 0xe5, 0x53, 0x48, 0x83, 0xec, 0x78};
+
+	const uintptr_t build_frustum_va     = base + kRvaBuildFrustum;
+	const uintptr_t build_batch_va       = base + kRvaBuildBatchCuller;
+	if (!vr_cull_detail::IsCommittedReadable(build_frustum_va, sizeof(kExpectedBuildFrustum)) ||
+	    !vr_cull_detail::IsCommittedReadable(build_batch_va, sizeof(kExpectedBuildBatch)) ||
+	    std::memcmp(reinterpret_cast<const void*>(build_frustum_va), kExpectedBuildFrustum,
+	                sizeof(kExpectedBuildFrustum)) != 0 ||
+	    std::memcmp(reinterpret_cast<const void*>(build_batch_va), kExpectedBuildBatch,
+	                sizeof(kExpectedBuildBatch)) != 0) {
+		std::printf("VR culling: game executable signatures did not match; hooks skipped\n");
+		return;
+	}
+
+	bool     in_elf_slack = false;
+	uint8_t* tramp_page   = vr_cull_detail::AllocNearTrampoline(base, in_elf_slack);
+	if (tramp_page == nullptr) {
+		std::printf("VR culling: failed to allocate near trampoline; hooks skipped\n");
+		return;
+	}
+
+	vr_cull_detail::g_orig_build_frustum =
+	    reinterpret_cast<vr_cull_detail::BuildFrustumFn>(build_frustum_va);
+	vr_cull_detail::g_orig_build_batch_culler =
+	    reinterpret_cast<vr_cull_detail::BuildBatchCullerFn>(build_batch_va);
+
+	uint8_t*        cursor      = tramp_page;
+	const uintptr_t tramp_main  = vr_cull_detail::EmitTrampoline(
+	    cursor, reinterpret_cast<const void*>(&vr_cull_detail::HookMainFrustum), in_elf_slack);
+	const uintptr_t tramp_batch = vr_cull_detail::EmitTrampoline(
+	    cursor, reinterpret_cast<const void*>(&vr_cull_detail::HookBatchCuller), in_elf_slack);
+	const uintptr_t tramp_cam   = vr_cull_detail::EmitTrampoline(
+	    cursor, reinterpret_cast<const void*>(&vr_cull_detail::HookCameraFrustum), in_elf_slack);
+	if (!tramp_main || !tramp_batch || !tramp_cam) {
+		std::printf("VR culling: failed to write trampolines; hooks skipped\n");
+		return;
+	}
+
+	int patched = 0;
+	if (vr_cull_detail::PatchRel32(base + kRvaMainFrustumCall, 0xE8, build_frustum_va, tramp_main)) {
+		++patched;
+	}
+	if (vr_cull_detail::PatchRel32(base + kRvaBatchCullerCall, 0xE8, build_batch_va, tramp_batch)) {
+		++patched;
+	}
+	if (vr_cull_detail::PatchRel32(base + kRvaCamFrustumJmp1, 0xE9, build_frustum_va, tramp_cam)) {
+		++patched;
+	}
+	if (vr_cull_detail::PatchRel32(base + kRvaCamFrustumJmp2, 0xE9, build_frustum_va, tramp_cam)) {
+		++patched;
+	}
+	if (vr_cull_detail::PatchRel32(base + kRvaCamFrustumJmp3, 0xE9, build_frustum_va, tramp_cam)) {
+		++patched;
+	}
+
+	// Keep CPU manual occlusion planes enabled by default (cuts ~500+ off-screen draws/frame on heavy levels);
+	// set KYTY_VR_CULL_DISABLE_OCC_PLANES=1 to disable if 6DOF leaning exposes an occluder seam.
+	bool occ_planes_disabled = false;
+	const char* env_occ_planes = std::getenv("KYTY_VR_CULL_DISABLE_OCC_PLANES");
+	if (env_occ_planes && std::strcmp(env_occ_planes, "1") == 0) {
+		const uintptr_t occ_va = base + kRvaIsCulledOccPlane;
+		static constexpr uint8_t kExpectedOcc[6] = {0xc5, 0xf8, 0x10, 0x01, 0x8b, 0x0e};
+		static constexpr uint8_t kPatchOcc[3]    = {0x31, 0xc0, 0xc3}; // xor eax, eax; ret
+		if (vr_cull_detail::IsCommittedReadable(occ_va, sizeof(kExpectedOcc)) &&
+		    std::memcmp(reinterpret_cast<const void*>(occ_va), kExpectedOcc, sizeof(kExpectedOcc)) == 0) {
+			occ_planes_disabled = vr_cull_detail::WriteProtectedBytes(occ_va, kPatchOcc, sizeof(kPatchOcc));
+		}
+	}
+
+	// Disable GPU Hi-Z OcclusionCullingCS by default in VR (KYTY_VR_CULL_DISABLE_GPU_OCC=0 to re-enable):
+	// OcclusionCullingCS culls against previous-frame/flat depth & screen bounds, causing objects (billboards,
+	// cones, buildings) to disappear while moving/turning the head in VR. Taking the engine's own non-culled
+	// display-list path also avoids the GatherCullingData + OcclusionCullingCS compute overhead.
+	bool gpu_occ_disabled = false;
+	const char* env_gpu_occ = std::getenv("KYTY_VR_CULL_DISABLE_GPU_OCC");
+	if (!env_gpu_occ || std::strcmp(env_gpu_occ, "0") != 0) {
+		const uintptr_t main_occ_va = base + kRvaGpuOccCheckMain;
+		static constexpr uint8_t kExpectedMainOcc[6] = {0x22, 0x90, 0x54, 0x02, 0x00, 0x00};
+		static constexpr uint8_t kPatchMainOcc[6]    = {0x30, 0xd2, 0x90, 0x90, 0x90, 0x90};
+		if (vr_cull_detail::IsCommittedReadable(main_occ_va, sizeof(kExpectedMainOcc)) &&
+		    std::memcmp(reinterpret_cast<const void*>(main_occ_va), kExpectedMainOcc,
+		                sizeof(kExpectedMainOcc)) == 0) {
+			gpu_occ_disabled =
+			    vr_cull_detail::WriteProtectedBytes(main_occ_va, kPatchMainOcc, sizeof(kPatchMainOcc));
+		}
+		const uintptr_t cloud_occ_va = base + kRvaGpuOccCheckClouds;
+		static constexpr uint8_t kExpectedCloudOcc[7] = {0x0f, 0xb6, 0x98, 0x54, 0x02, 0x00, 0x00};
+		static constexpr uint8_t kPatchCloudOcc[7]    = {0x31, 0xdb, 0x90, 0x90, 0x90, 0x90, 0x90};
+		if (vr_cull_detail::IsCommittedReadable(cloud_occ_va, sizeof(kExpectedCloudOcc)) &&
+		    std::memcmp(reinterpret_cast<const void*>(cloud_occ_va), kExpectedCloudOcc,
+		                sizeof(kExpectedCloudOcc)) == 0) {
+			(void)vr_cull_detail::WriteProtectedBytes(cloud_occ_va, kPatchCloudOcc,
+			                                          sizeof(kPatchCloudOcc));
+		}
+		// Redirect DisplayWithCulling(mgr, cmd, list, cb, depth, user) -> DisplayNoCulling(cmd, list, cb, user)
+		// so every remaining pass (transparent, decals, forward opaque, grass, clouds) skips OcclusionCullingCS.
+		const uintptr_t with_cull_va = base + kRvaDisplayWithCull;
+		const uintptr_t no_cull_va   = base + kRvaDisplayNoCull;
+		static constexpr uint8_t kExpectedWithCull[17] = {
+		    0x55, 0x48, 0x89, 0xe5, 0x41, 0x57, 0x41, 0x56, 0x41, 0x55, 0x41, 0x54, 0x53, 0x48, 0x81, 0xec, 0xf8};
+		if (vr_cull_detail::IsCommittedReadable(with_cull_va, sizeof(kExpectedWithCull)) &&
+		    std::memcmp(reinterpret_cast<const void*>(with_cull_va), kExpectedWithCull,
+		                sizeof(kExpectedWithCull)) == 0) {
+			uint8_t patch_redirect[17] = {
+			    0x48, 0x89, 0xf7, // mov rdi, rsi
+			    0x48, 0x89, 0xd6, // mov rsi, rdx
+			    0x48, 0x89, 0xca, // mov rdx, rcx
+			    0x4c, 0x89, 0xc9, // mov rcx, r9
+			    0xe9, 0x00, 0x00, 0x00, 0x00 // jmp rel32 -> DisplayNoCulling
+			};
+			const int32_t rel = static_cast<int32_t>(
+			    static_cast<int64_t>(no_cull_va) - static_cast<int64_t>(with_cull_va + 17));
+			std::memcpy(patch_redirect + 13, &rel, sizeof(rel));
+			gpu_occ_disabled = vr_cull_detail::WriteProtectedBytes(
+			    with_cull_va, patch_redirect, sizeof(patch_redirect)) || gpu_occ_disabled;
+		}
+	}
+
+	std::printf("VR culling: installed %d/5 frustum hooks (margin=%.1f deg, pullback=%.2f m, "
+	            "occ_planes_disabled=%d, gpu_occ_disabled=%d)\n",
+	            patched, vr_cull_detail::CullMarginRadians() / 0.017453292519943295f,
+	            vr_cull_detail::CullPullbackMeters(), occ_planes_disabled ? 1 : 0,
+	            gpu_occ_disabled ? 1 : 0);
+}
+
+} // namespace Libs::Vr
+#else
+namespace Libs::Vr {
+inline void InstallVrCullingHooks() {}
+} // namespace Libs::Vr
+#endif

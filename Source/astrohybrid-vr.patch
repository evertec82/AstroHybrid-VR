+    // like Archipelago do not exhaust Draw Shadow while staying safely inside the 12800 MiB direct-memory budget.
+    constexpr unsigned dcbOld[5] = {16u, 16u, 16u, 32u, 16u};
+    constexpr unsigned dcbNew[5] = {20u, 20u, 20u, 32u, 20u};

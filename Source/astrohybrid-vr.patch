+        {0x73af2fc,0x741669c,0x7416738,3},{0x73af309,0x74166a9,0x7416746,4}};
+    for(const auto& row:constructors) for(int i=0;i<3;++i) {
+        auto tier=row[3]; add(row[i],widths[tier],tier && preserveNativeTiers ? width:input(width));

 namespace Libs::Graphics {
 
+namespace VulkanCallTiming {
+Live::Switch enabled("KYTY_VK_CALL_TIMING", Live::ParseDefaultOff);
+thread_local std::array<Counts, static_cast<unsigned>(Op::Count)> counts {};
+
+thread_local uint64_t omitted_writes = 0;
+
+void ReportIfDue(Clock::time_point now) {
+	static thread_local auto start = now;
+	if (now - start < std::chrono::seconds(5)) return;
+	constexpr std::array names {"vertex", "index", "pushDesc", "updateSet", "bindSet", "pushConst",
+	                            "pipeline", "draw", "drawIndexed", "drawMesh"};
+	static_assert(names.size() == static_cast<unsigned>(Op::Count));
+	std::string line = fmt::format("Vulkan CPU calls {:.2f}s (issued/skipped/samples/mean_ns):",
+	                               std::chrono::duration<double>(now - start).count());
+	for (size_t i = 0; i < counts.size(); ++i) {
+		const auto& v = counts[i];
+		if (v.calls || v.skipped)
+			line += fmt::format(" {}={}/{}/{}/{}", names[i], v.calls, v.skipped, v.samples,
+			                    v.samples ? v.ns / v.samples : 0);
+	}
+	std::fprintf(stderr, "%s prefix_writes_skipped=%llu\n", line.c_str(), static_cast<unsigned long long>(omitted_writes));
+	omitted_writes = 0;
+	counts = {};
+	start = now;
+}
+} // namespace VulkanCallTiming
+
+static Live::Switch g_descriptor_prefix("KYTY_DESCRIPTOR_PREFIX_REUSE", Live::ParseDefaultOn);
+static Live::Switch g_input_bindings("KYTY_INPUT_BIND_REUSE", Live::ParseDefaultOn);
+
+bool CommandBuffer::ReusesIndex(vk::Buffer buffer, vk::DeviceSize offset, vk::IndexType type) const {
+	if (!g_input_bindings.On()) {
+		m_input.index = nullptr;
+		return false;
+	}
+	if (buffer && m_input.index == buffer && m_input.index_offset == offset && m_input.index_type == type)
+		return true;
+	m_input.index = buffer;
+	m_input.index_offset = offset;
+	m_input.index_type = type;
+	return false;
+}
+
+bool CommandBuffer::ReusesVertices(uint32_t first, uint32_t count, const vk::Buffer* buffers,
+                                   const vk::DeviceSize* offsets, const vk::DeviceSize* sizes,
+                                   const vk::DeviceSize* strides) const {
+	// Only the bounded, zero-based form emitted by guest draws. Any other form invalidates it.
+	if (!g_input_bindings.On() || first || !count || !sizes || strides || count > m_input.buffers.size()) {
+		m_input.valid_prefix = 0;
+		return false;
+	}
+	if (count <= m_input.valid_prefix &&

diff --git a/tests/FrameStepTests.cpp b/tests/FrameStepTests.cpp
new file mode 100644
index 00000000..6572f2d3
--- /dev/null
+++ b/tests/FrameStepTests.cpp
@@ -0,0 +1,59 @@
+#include "common/frameStep.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+
+namespace {
+constexpr double nominal = 1.0 / 60.0;
+void Check(bool condition, const char* message) {
+	if (!condition) { std::fprintf(stderr,"FrameStepTests: %s\n",message); std::abort(); }
+}
+bool Near(double a,double b) { return std::abs(a-b)<1e-7; }
+}
+int main() {
+	for (const uint64_t period: {20'000'000ull,33'333'333ull,66'666'667ull,76'923'077ull,100'000'000ull}) {
+		Common::FrameStepClock clock;
+		uint64_t now=1'000'000'000;
+		clock.Advance(now,nominal,true);
+		double simulated=0;
+		for (int frame=0;frame<100;++frame) simulated+=clock.Advance(now+=period,nominal,true);
+		Check(Near(simulated,double(period)*1e-9*100),"simulation does not follow elapsed wall time");
+	}
+	{
+		Common::FrameStepClock jitter;
+		uint64_t tick=1'000'000'000;
+		jitter.Advance(tick,nominal,true);
+		double sum=0;
+		for(int i=0;i<1000;++i) {
+			sum+=jitter.Advance(tick+=15'000'000,nominal,true);
+			sum+=jitter.Advance(tick+=18'333'334,nominal,true);
+		}
+		Check(Near(sum,33.333334),"alternating short/long frames accumulated clock drift");
+	}
+	Common::FrameStepClock clock;
+	uint64_t now=1'000'000'000;
+	Check(Near(clock.Advance(now,nominal,true),nominal),"first sample advanced time unexpectedly");
+	now+=8'333'333;
+	Check(Near(clock.Advance(now,nominal,true),0.008333333),"fast frames accumulated excess simulation time");
+	now+=200'000'000;
+	Check(Near(clock.Advance(now,nominal,true),0.1),"long physics step exceeded its safety bound");
+	now+=1'000'000'000;
+	Check(Near(clock.Advance(now,nominal,true),nominal),"pause/loading stall caused a catch-up jump");
+	now+=33'333'333;
+	Check(Near(clock.Advance(now,nominal,true),1.0/30),"pause recovery retained old elapsed time");
+	now+=66'666'667;
+	Check(Near(clock.Advance(now,nominal,false),nominal),"probe mode altered game time");
+	now+=33'333'333;
+	Check(Near(clock.Advance(now,nominal,true),1.0/30),"mode switch accumulated disabled time");
+	now+=80'000'000;
+	Check(Near(clock.Advance(now,nominal,true),0.08),"slow rendering interval was not preserved");
+	now+=25'000'000;
+	Check(Near(clock.Advance(now,nominal,true),0.025),"improved rendering retained a previous slow interval");
+	Check(Near(clock.Advance(now-1,nominal,true),nominal),"backwards clock advanced time");
+	now+=33'333'333;
+	Check(Near(clock.Advance(now,std::numeric_limits<double>::quiet_NaN(),false),nominal),
+	      "invalid nominal interval escaped validation");
+	std::puts("FrameStepTests: elapsed-time integration, bounds, discontinuities and mode transitions passed");
+}
diff --git a/src/graphics/host_gpu/renderer/vulkanCallTiming.h b/src/graphics/host_gpu/renderer/vulkanCallTiming.h
new file mode 100644
--- /dev/null
+++ b/src/graphics/host_gpu/renderer/vulkanCallTiming.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include "common/liveSwitch.h"
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+
+namespace Libs::Graphics::VulkanCallTiming {
+
+enum class Op : unsigned { Vertex, Index, PushDescriptors, UpdateSet, BindSet, PushConstants,
+                           Pipeline, Draw, IndexedDraw, MeshDraw, Count };
+struct Counts {
+	uint64_t calls = 0, skipped = 0, samples = 0, ns = 0;
+};
+using Clock = std::chrono::steady_clock;
+extern Live::Switch enabled;
+extern thread_local std::array<Counts, static_cast<unsigned>(Op::Count)> counts;
+extern thread_local uint64_t omitted_writes;
+void ReportIfDue(Clock::time_point now);
+
+// Time the native call only, on a sample of calls per operation and recording thread.
+template <class F> inline void Record(Op op, F call) {
+	if (enabled.On()) [[unlikely]] {
+		auto& value = counts[static_cast<unsigned>(op)];
+		if ((++value.calls & 63) == 1) {
+			const auto start = Clock::now();
+			call();
+			const auto end = Clock::now();
+			value.ns += std::chrono::duration_cast<std::chrono::nanoseconds>(end - start).count();
+			++value.samples;
+			ReportIfDue(end);
+			return;
+		}
+	}
+	call();
+}
+inline void Skipped(Op op) {
+	if (enabled.On()) [[unlikely]] ++counts[static_cast<unsigned>(op)].skipped;
+}
+} // namespace Libs::Graphics::VulkanCallTiming
diff --git a/src/graphics/presentation/physicsFaultCapture.h b/src/graphics/presentation/physicsFaultCapture.h
new file mode 100644
--- /dev/null
+++ b/src/graphics/presentation/physicsFaultCapture.h
@@ -0,0 +1,59 @@
+#pragma once
+
+#if defined(_WIN32)
+#include <windows.h>
+#ifdef MemoryBarrier
+#undef MemoryBarrier
+#endif
+#include <atomic>
+#include <cstdio>
+#include <cstdint>
+
+namespace Libs::Vr {
+// Diagnostic only: never consumes an exception or changes guest memory/context.
+inline void DumpPhysicsRange(const char* name, uintptr_t address, size_t length) {
+    char text[256];
+    for (size_t offset = 0; offset < length; offset += 32) {
+        uint64_t words[4]{};
+        SIZE_T read = 0;
+        const bool valid = ReadProcessMemory(GetCurrentProcess(),
+            reinterpret_cast<void*>(address + offset), words, sizeof(words), &read) && read == sizeof(words);
+        const int count = valid ? std::snprintf(text, sizeof(text),
+            "PhysicsCapture %s +%03zx @%llx: %016llx %016llx %016llx %016llx\n",
+            name, offset, static_cast<unsigned long long>(address + offset),
+            words[0], words[1], words[2], words[3]) : std::snprintf(text, sizeof(text),
+            "PhysicsCapture %s @%llx: unreadable\n", name,
+            static_cast<unsigned long long>(address + offset));
+        DWORD written = 0;
+        if (count > 0) WriteFile(GetStdHandle(STD_ERROR_HANDLE), text,
+            static_cast<DWORD>(count), &written, nullptr);
+        if (!valid) break;
+    }
+}
+inline LONG CALLBACK CapturePhysicsFault(EXCEPTION_POINTERS* exception) {
+    if (!exception || !exception->ExceptionRecord || !exception->ContextRecord ||
+        exception->ExceptionRecord->ExceptionCode != EXCEPTION_ACCESS_VIOLATION)
+        return EXCEPTION_CONTINUE_SEARCH;
+    const auto& context = *exception->ContextRecord;
+    const auto base = reinterpret_cast<uintptr_t>(GetModuleHandleW(nullptr));
+    if (context.Rip < base || context.Rip - base != 0xb6f8c3)
+        return EXCEPTION_CONTINUE_SEARCH;
+    static std::atomic_bool captured{false};
+    if (captured.exchange(true)) return EXCEPTION_CONTINUE_SEARCH;
+    if (context.Rbp >= 0x10000 + 0x700) {
+        DumpPhysicsRange("traversal-locals", context.Rbp - 0x700, 0x700);
+        DumpPhysicsRange("traversal-top", context.Rbp - 0x40, 32);
+    }
+    DumpPhysicsRange("tree-header", context.Rdx, 128);
+    DumpPhysicsRange("last-tree-node", context.R15, 128);
+    DumpPhysicsRange("query", context.Rsi, 128);
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+inline void RegisterPhysicsFaultCapture() {
+    static const auto handler = AddVectoredExceptionHandler(1, CapturePhysicsFault);
+    (void)handler;
+}
+}
+#else
+namespace Libs::Vr { inline void RegisterPhysicsFaultCapture() {} }
+#endif
diff --git a/src/graphics/presentation/stagingSelection.h b/src/graphics/presentation/stagingSelection.h
new file mode 100644
--- /dev/null
+++ b/src/graphics/presentation/stagingSelection.h
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <cstdint>
+#include <cstddef>
+
+namespace Libs::Vr {
+
+// Caller holds the staging lock. A pending headset copy must retire before changing the held slot.
+template<class Slot, std::size_t N>
+int SelectSource(const Slot (&slots)[N], int held, uint64_t shown) {
+	int ready = -1;
+	int pending = -1;
+	for (std::size_t i = 0; i < N; ++i) {
+		const auto& slot = slots[i];
+		if (slot.sequence <= shown) continue;
+		if (slot.producer->IsFree(slot.tick)) {
+			if (ready < 0 || slot.sequence > slots[ready].sequence) ready = static_cast<int>(i);
+		} else if (pending < 0 || slot.sequence < slots[pending].sequence) {
+			pending = static_cast<int>(i);
+		}
+	}
+	if (ready >= 0) return ready;
+	if (held >= 0 && slots[held].sequence > shown) return held;
+	return pending;
+}
+
+template<class Slot, std::size_t N>
+int SelectWriteSlot(const Slot (&slots)[N], int latest, int held) {
+	static_assert(N >= 3);
+	int oldest = -1;
+	for (std::size_t i = 0; i < N; ++i) {
+		const auto index = static_cast<int>(i);
+		if (index == latest || index == held) continue;
+		if (oldest < 0 || slots[i].sequence < slots[oldest].sequence) oldest = index;
+	}
+	return oldest;
+}
+
+} // namespace Libs::Vr
diff --git a/tests/StereoStagingTests.cpp b/tests/StereoStagingTests.cpp
new file mode 100644
--- /dev/null
+++ b/tests/StereoStagingTests.cpp
@@ -0,0 +1,36 @@
+#include "graphics/presentation/stagingSelection.h"
+
+#include <cstdio>
+
+struct Timeline {
+	uint64_t completed;
+	bool IsFree(uint64_t tick) const { return tick <= completed; }
+};
+
+struct Slot {
+	uint64_t sequence = 0;
+	uint64_t tick = 0;
+	Timeline* producer = nullptr;
+};
+
+int main() {
+	using Libs::Vr::SelectSource;
+	using Libs::Vr::SelectWriteSlot;
+	Slot slots[3] {};
+	if (SelectSource(slots, -1, 0) != -1) return 1;
+	Timeline first {10}, second {1};
+	slots[0] = {1, 10, &first};
+	slots[1] = {2, 11, &first};
+	slots[2] = {3, 11, &first};
+	// A newer unfinished pair must not hide an intermediate completed pair.
+	if (SelectSource(slots, 2, 0) != 0 || SelectSource(slots, 1, 1) != 1) return 2;
+	if (SelectWriteSlot(slots, 2, 0) != 1 || SelectWriteSlot(slots, 0, -1) != 1) return 3;
+	first.completed = 11;
+	// Publication order also distinguishes two frames recorded at the same timeline tick.
+	if (SelectSource(slots, 1, 1) != 2 || SelectSource(slots, -1, 3) != -1) return 4;
+	slots[0] = {4, 2, &second};
+	if (SelectSource(slots, -1, 2) != 2) return 5;
+	second.completed = 2;
+	if (SelectSource(slots, -1, 2) != 0) return 6;
+	std::puts("Stereo staging selection passed");
+}

+bool RenderExecutor::TryNativeTemporalResolve(CommandBuffer& buffer, PreparedBindings& pixel,
+                                              ImageId output) {
+	static const bool enabled = [] {
+		const char* vr = std::getenv("ASTROHYBRID_VR");
+		if (vr == nullptr || std::strcmp(vr, "1") != 0) {
+			return false;
+		}
+		const char* opt = std::getenv("KYTY_VR_NATIVE_RESOLVE_BLIT");
+		return opt == nullptr || std::strcmp(opt, "0") != 0;
+	}();
+	if (!enabled || Dlss::Requested() || pixel.runtime == nullptr || !*pixel.runtime) {
+		return false;
+	}
+	if (pixel.runtime->program->shader_hash != 0x2936e5eca99d75e7ULL) {
+		return false;
+	}
+	if (pixel.images.size() < 2 || !output) {
+		return false;
+	}
+	auto&      cache    = m_context.GetTextureCache();
+	const auto color_id = pixel.images[1].image_id;
+	if (!color_id || color_id == output || !cache.m_slot_images.try_get(color_id) ||
+	    !cache.m_slot_images.try_get(output)) {
+		return false;
+	}
+	auto& color = cache.GetImage(color_id);
+	auto& out   = cache.GetImage(output);
+	if (!color.backing.image || !out.backing.image || color.info.samples != 1 ||
+	    out.info.samples != 1 || color.info.extent.width == 0 || color.info.extent.height == 0 ||
+	    out.info.extent.width == 0 || out.info.extent.height == 0) {
+		return false;
+	}
+	buffer.EndRendering();
+	const auto cmd = buffer.Handle();
+	color.Transit(vk::ImageLayout::eTransferSrcOptimal, vk::AccessFlagBits2::eTransferRead, {},
+	              cmd);
+	out.Transit(vk::ImageLayout::eTransferDstOptimal, vk::AccessFlagBits2::eTransferWrite, {}, cmd);
+	if (color.info.extent.width == out.info.extent.width &&
+	    color.info.extent.height == out.info.extent.height &&
+	    color.backing.format == out.backing.format) {
+		vk::ImageCopy copy {};
+		copy.srcSubresource = {vk::ImageAspectFlagBits::eColor, 0, 0, 1};
+		copy.dstSubresource = {vk::ImageAspectFlagBits::eColor, 0, 0, 1};
+		copy.extent         = {out.info.extent.width, out.info.extent.height, 1};
+		cmd.copyImage(color.backing.image, vk::ImageLayout::eTransferSrcOptimal, out.backing.image,
+		              vk::ImageLayout::eTransferDstOptimal, 1, &copy);
+	} else {
+		vk::ImageBlit blit {};
+		blit.srcSubresource = {vk::ImageAspectFlagBits::eColor, 0, 0, 1};
+		blit.dstSubresource = {vk::ImageAspectFlagBits::eColor, 0, 0, 1};
+		blit.srcOffsets[1]  = {static_cast<int32_t>(color.info.extent.width),
+		                       static_cast<int32_t>(color.info.extent.height), 1};
+		blit.dstOffsets[1]  = {static_cast<int32_t>(out.info.extent.width),
+		                       static_cast<int32_t>(out.info.extent.height), 1};
+		cmd.blitImage(color.backing.image, vk::ImageLayout::eTransferSrcOptimal, out.backing.image,
+		              vk::ImageLayout::eTransferDstOptimal, 1, &blit, vk::Filter::eLinear);
+	}
+	out.NoteContentWrite();
+	cache.CommitGpuWrite(out);
+	static std::atomic<uint32_t> logged {0};
+	if (logged.fetch_add(1, std::memory_order_relaxed) < 2) {
+		std::printf("VR native resolve (eye %d): %ux%u -> %ux%u via transfer blit\n",
+		            Vr::CameraRenderEye(), color.info.extent.width, color.info.extent.height,
+		            out.info.extent.width, out.info.extent.height);
+		std::fflush(stdout);
+	}
+	return true;
+}

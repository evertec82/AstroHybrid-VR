new file mode 100644
index 00000000..f28d6af9
--- /dev/null
+++ b/src/graphics/presentation/stereoFrame.h
@@ -0,0 +1,131 @@
+#pragma once
+
+#include "graphics/presentation/cameraTracking.h"
+
+#include <cstdint>
+#include <limits>
+#include <optional>
+
+namespace Libs::Vr {
+
+using CameraBlock = std::array<float, 144>;
+
+// Render inputs, not a displayed image. Ownership is by value so later game uploads
+// and tracking polls cannot change either eye while its commands are being recorded.
+struct StereoFrameMetadata {
+	uint64_t id = 0;
+	VrFramePose pose;
+	// OpenXR order: left, right, up, down. Kept with the rendered frame.
+	std::array<std::array<float, 4>, 2> fovs;
+	bool headset_projection = false;
+	bool flat_screen = false;
+};
+
+struct StereoFrame : StereoFrameMetadata {
+	std::array<CameraBlock, 2> cameras;
+};
+
+// GPU resolver thread only; the headset thread receives a value copy in its staging slot.
+inline std::optional<StereoFrameMetadata> active_stereo_frame;
+
+inline bool ValidStereoPose(const VrPose& pose) {
+	if (!pose.valid) return false;
+	float norm = 0;
+	for (float value: pose.orientation) {
+		if (!std::isfinite(value)) return false;
+		norm += value * value;
+	}
+	for (float value: pose.position)
+		if (!std::isfinite(value)) return false;
+	return std::abs(norm - 1.0f) < 0.0001f;
+}
+
+// Screen-space draws use the same normalized coordinates in both eyes. Choose
+// parallel eye axes and map those coordinates to a common plane, while enclosing
+// the runtime's original (possibly canted) fields of view on that plane.
+inline bool AlignScreenSpaceOverlays(VrFramePose& pose, float distance) {
+	if (!std::isfinite(distance) || distance <= 0) return false;
+	const float infinity = std::numeric_limits<float>::infinity();
+	float min_x = infinity, min_y = infinity, max_x = -infinity, max_y = -infinity;
+	for (size_t eye = 0; eye < 2; ++eye) {
+		const auto& p = pose.eyes[eye];
+		EyeProjection lens;
+		if (!ValidStereoPose(p) || !GetEyeProjection(pose.fovs[eye], lens)) return false;
+		const auto view = CameraEyeInverse(p);
+		const auto& [left, right, up, down] = pose.fovs[eye];
+		const float depth = distance + p.position[2];
+		if (depth <= 0) return false;
+		for (const float x: {std::tan(left), std::tan(right)}) {
+			for (const float y: {std::tan(down), std::tan(up)}) {
+				// The transpose of the view rotation takes an eye ray to head space.
+				const float forward = view[10] - view[8] * x - view[9] * y;
+				if (forward < 0.1f) return false;
+				const float plane_x = p.position[0] + depth * (view[0] * x + view[1] * y - view[2]) / forward;
+				const float plane_y = p.position[1] + depth * (view[4] * x + view[5] * y - view[6]) / forward;
+				min_x = std::min(min_x, plane_x);
+				max_x = std::max(max_x, plane_x);
+				min_y = std::min(min_y, plane_y);
+				max_y = std::max(max_y, plane_y);
+			}
+		}
+	}
+	auto fovs = pose.fovs;
+	for (size_t eye = 0; eye < 2; ++eye) {
+		const auto& p = pose.eyes[eye].position;
+		const float depth = distance + p[2];
+		fovs[eye] = {std::atan((min_x - p[0]) / depth), std::atan((max_x - p[0]) / depth),
+		             std::atan((max_y - p[1]) / depth), std::atan((min_y - p[1]) / depth)};
+		EyeProjection lens;
+		if (!GetEyeProjection(fovs[eye], lens)) return false;
+	}
+	for (auto& eye: pose.eyes) {
+		eye.orientation[0] = eye.orientation[1] = eye.orientation[2] = 0;
+		eye.orientation[3] = 1;
+	}
+	pose.fovs = fovs;
+	return true;
+}
+
+// The renderer must additionally isolate temporal images, view-dependent GPU writes,
+// and their previous camera inputs. This helper alone does not enable stereo replay.
+inline std::optional<StereoFrame> PrepareStereoFrame(uint64_t id, const CameraBlock& source,
+                                                     const CameraMatrix& head_transform,
+                                                     const VrFramePose& pose,
+                                                     const CameraMatrix& previous_head = {},
+                                                     const VrFramePose& previous_pose = {},
+                                                     bool headset_projection = false) {
+	if (!ValidStereoPose(pose.head) || !ValidStereoPose(pose.eyes[0]) ||
+	    !ValidStereoPose(pose.eyes[1])) return std::nullopt;
+	StereoFrame frame;
+	frame.id = id;
+	frame.pose = pose;
+	std::array<EyeProjection, 2> lenses;
+	frame.headset_projection = headset_projection &&
+	    std::abs(source[40]) < 0.01f && std::abs(source[41]) < 0.01f &&
+	    GetEyeProjection(pose.fovs[0], lenses[0]) && GetEyeProjection(pose.fovs[1], lenses[1]);
+	for (size_t eye = 0; eye < 2; ++eye) {
+		frame.cameras[eye] = source;
+		const auto transform = CameraMultiply(head_transform, CameraEyeInverse(pose.eyes[eye]));
+		if (frame.headset_projection) {
+			const auto previous_transform = ValidStereoPose(previous_pose.eyes[eye])
+			    ? CameraMultiply(previous_head, CameraEyeInverse(previous_pose.eyes[eye])) : transform;
+			EyeProjection previous_lens;
+			const auto* prior = GetEyeProjection(previous_pose.fovs[eye], previous_lens)
+			    ? &previous_lens : &lenses[eye];
+			if (!RotateCameraBlock(frame.cameras[eye], transform, &previous_transform,
+			                       &lenses[eye], prior)) return std::nullopt;
+			frame.fovs[eye] = pose.fovs[eye];
+			continue;
+		}
+		if (!RotateCameraBlock(frame.cameras[eye], transform)) return std::nullopt;
+		const auto& camera = frame.cameras[eye];
+		const float sx = camera[32], sy = camera[37], ox = camera[40], oy = camera[41];
+		if (!(sx > 0 && sy > 0) || std::abs(ox) >= 1 || std::abs(oy) >= 1)
+			return std::nullopt;
+		frame.fovs[eye] = {std::atan((-1 + ox) / sx), std::atan((1 + ox) / sx),
+		                   std::atan((1 + oy) / sy), std::atan((-1 + oy) / sy)};
+	}
+	return frame;
+}
+
+} // namespace Libs::Vr

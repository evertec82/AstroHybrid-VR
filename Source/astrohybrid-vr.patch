--- /dev/null
+++ b/src/graphics/presentation/physicsFaultCapture.h
@@ -0,0 +1,59 @@
+#pragma once
+
+#if defined(_WIN32)
+#include <windows.h>
+#ifdef MemoryBarrier
+#undef MemoryBarrier
+#endif
+#include <atomic>
+#include <cstdio>
+#include <cstdint>
+
+namespace Libs::Vr {
+// Diagnostic only: never consumes an exception or changes guest memory/context.
+inline void DumpPhysicsRange(const char* name, uintptr_t address, size_t length) {
+    char text[256];
+    for (size_t offset = 0; offset < length; offset += 32) {
+        uint64_t words[4]{};
+        SIZE_T read = 0;
+        const bool valid = ReadProcessMemory(GetCurrentProcess(),
+            reinterpret_cast<void*>(address + offset), words, sizeof(words), &read) && read == sizeof(words);
+        const int count = valid ? std::snprintf(text, sizeof(text),
+            "PhysicsCapture %s +%03zx @%llx: %016llx %016llx %016llx %016llx\n",
+            name, offset, static_cast<unsigned long long>(address + offset),
+            words[0], words[1], words[2], words[3]) : std::snprintf(text, sizeof(text),
+            "PhysicsCapture %s @%llx: unreadable\n", name,
+            static_cast<unsigned long long>(address + offset));
+        DWORD written = 0;
+        if (count > 0) WriteFile(GetStdHandle(STD_ERROR_HANDLE), text,
+            static_cast<DWORD>(count), &written, nullptr);
+        if (!valid) break;
+    }
+}
+inline LONG CALLBACK CapturePhysicsFault(EXCEPTION_POINTERS* exception) {
+    if (!exception || !exception->ExceptionRecord || !exception->ContextRecord ||
+        exception->ExceptionRecord->ExceptionCode != EXCEPTION_ACCESS_VIOLATION)
+        return EXCEPTION_CONTINUE_SEARCH;
+    const auto& context = *exception->ContextRecord;
+    const auto base = reinterpret_cast<uintptr_t>(GetModuleHandleW(nullptr));
+    if (context.Rip < base || context.Rip - base != 0xb6f8c3)
+        return EXCEPTION_CONTINUE_SEARCH;
+    static std::atomic_bool captured{false};
+    if (captured.exchange(true)) return EXCEPTION_CONTINUE_SEARCH;
+    if (context.Rbp >= 0x10000 + 0x700) {
+        DumpPhysicsRange("traversal-locals", context.Rbp - 0x700, 0x700);
+        DumpPhysicsRange("traversal-top", context.Rbp - 0x40, 32);
+    }
+    DumpPhysicsRange("tree-header", context.Rdx, 128);
+    DumpPhysicsRange("last-tree-node", context.R15, 128);
+    DumpPhysicsRange("query", context.Rsi, 128);
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+inline void RegisterPhysicsFaultCapture() {
+    static const auto handler = AddVectoredExceptionHandler(1, CapturePhysicsFault);
+    (void)handler;
+}
+}
+#else
+namespace Libs::Vr { inline void RegisterPhysicsFaultCapture() {} }
+#endif

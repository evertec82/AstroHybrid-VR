+void CompiledShaderInfo::AnalyzeDescriptorLayout() {
+	dense_storage_buffers = true;
+	single_image_views = true;
+	std::vector<uint8_t> seen(info.images.size());
+	for (const auto& binding: bindings.descriptors) {
+		const auto& resources = binding.resources;
+		if (binding.kind == DescriptorBindingKind::Buffers) {
+			if (resources.empty()) {
+				dense_storage_buffers = false;
+			}
+			for (size_t i = 1; i < resources.size(); ++i) {
+				if (resources[i] != uint64_t(resources.front()) + i) {
+					dense_storage_buffers = false;
+					break;
+				}
+			}
+		} else if (ImageBindingResourceClass(binding.kind) != ImageResourceClass::None) {
+			for (const auto resource: resources) {
+				if (resource >= seen.size() || seen[resource]) {
+					single_image_views = false;
+				} else {
+					seen[resource] = 1;
+				}
+			}
+		}
+	}
+	for (const auto present: seen) {
+		if (!present) single_image_views = false;
+	}
+}
+
 CompiledShaderInfo Program::TakeCompiledInfo() && {
 	CompiledShaderInfo result {
 	    .stage           = stage,
@@ -172,6 +203,7 @@ CompiledShaderInfo Program::TakeCompiledInfo() && {
 			result.param_export_mask |= 1u << output.index;
 		}
 	}
+	result.AnalyzeDescriptorLayout();
 	return result;
 }
 

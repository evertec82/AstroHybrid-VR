+		blit.dstSubresource = {vk::ImageAspectFlagBits::eColor, 0, 0, 1};
+		blit.srcOffsets[1] = {static_cast<int32_t>(images[eye]->extent.width),
+		                       static_cast<int32_t>(images[eye]->extent.height), 1};
+		blit.dstOffsets[0] = {eye * half, 0, 0};
+		blit.dstOffsets[1] = {eye * half + static_cast<int32_t>(slot.content_extent.width),
+		                       static_cast<int32_t>(slot.content_extent.height), 1};
+		if (slot.content_extent.width == left.extent.width &&
+		    slot.content_extent.height == left.extent.height &&
+		    images[eye]->format == slot.image.format) {
+			vk::ImageCopy copy {};
+			copy.srcSubresource = blit.srcSubresource;
+			copy.dstSubresource = blit.dstSubresource;
+			copy.dstOffset = blit.dstOffsets[0];
+			copy.extent = vk::Extent3D {slot.content_extent.width, slot.content_extent.height, 1};
+			vk_command.copyImage(images[eye]->image, vk::ImageLayout::eTransferSrcOptimal,
+			                     slot.image.image, vk::ImageLayout::eTransferDstOptimal, 1, &copy);
+		} else {
+			vk_command.blitImage(images[eye]->image, vk::ImageLayout::eTransferSrcOptimal,
+			                     slot.image.image, vk::ImageLayout::eTransferDstOptimal,
+			                     1, &blit, vk::Filter::eLinear);
+		}
+		slot.eye_heads[eye] = frame.pose.head;
+		slot.rendered_eyes[eye] = frame.pose.eyes[eye];
+		const auto& fov = frame.fovs[eye];
+		slot.eye_fovs[eye] = {fov[0], fov[1], fov[2], fov[3]};
+	}
+	Barrier(vk_command, slot.image.image, vk::ImageLayout::eTransferDstOptimal,
+	        vk::ImageLayout::eTransferSrcOptimal, 1, TRANSFER_WRITE, TRANSFER_READ);

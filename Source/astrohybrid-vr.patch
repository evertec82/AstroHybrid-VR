diff --git a/src/graphics/shader/recompiler/ir/graphicsPushData.h b/src/graphics/shader/recompiler/ir/graphicsPushData.h
new file mode 100644
index 00000000..342a3e71
--- /dev/null
+++ b/src/graphics/shader/recompiler/ir/graphicsPushData.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include "graphics/shader/recompiler/ir/ShaderIR.h"
+
+namespace Libs::Graphics::ShaderRecompiler::IR::GraphicsPushData {
+
+// The permutation key already stores a 32-bit cursor. Keep old 128-byte keys intact.
+// Only the cache cursor carries this bit; GPU offsets and serialized bindings are plain dwords.
+constexpr uint32_t WideKey = 1u << 31;
+constexpr uint32_t ReserveKey = 1u << 30;
+constexpr uint32_t ModeMask = WideKey | ReserveKey;
+constexpr uint32_t WideDwords = 64;
+constexpr uint32_t VertexReserveDwords = 28;
+
+constexpr bool Fits(uint32_t offset, uint32_t size, uint32_t limit) {
+	return size != 0 && offset <= limit && size <= limit - offset;
+}
+
+constexpr uint32_t StartFor(uint32_t key, uint32_t size, bool pixel = false) {
+	const auto cursor = key & ~ModeMask;
+	auto limit = (key & WideKey) ? WideDwords : PushData::DwordCount;
+	if (pixel && (key & ReserveKey)) limit -= VertexReserveDwords;
+	return Fits(cursor, size, limit) ? cursor : PushData::NoStart;
+}
+
+inline void Advance(uint32_t& key, const BindingLayout& layout) {
+	const auto mode = key & ModeMask;
+	layout.AdvancePushData(key);
+	key |= mode;
+}
+
+inline uint32_t RangeDwords(const BindingLayout& layout) {
+	uint32_t end = 0;
+	layout.AdvancePushData(end);
+	return end > PushData::DwordCount ? WideDwords : PushData::DwordCount;
+}
+
+static_assert(StartFor(WideKey | ReserveKey, 36, true) == 0);
+static_assert(StartFor(WideKey | ReserveKey, 37, true) == PushData::NoStart);
+static_assert(StartFor(WideKey | ReserveKey | 36, 28) == 36);
+static_assert(StartFor(31, 2) == PushData::NoStart);
+static_assert(StartFor(WideKey | 31, 33) == 31);
+static_assert(StartFor(WideKey | 31, 34) == PushData::NoStart);
+static_assert(StartFor(WideKey | 64, 0) == PushData::NoStart);
+
+} // namespace Libs::Graphics::ShaderRecompiler::IR::GraphicsPushData

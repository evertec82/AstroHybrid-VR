+using BuildFrustumFn = void(__attribute__((sysv_abi))*)(const float* vp, float* out_planes,
+                                                        uint32_t* out_corners);
+using BuildBatchCullerFn = void(__attribute__((sysv_abi))*)(uint8_t* culler, const float* view,
+                                                            const float* proj);
+
+inline BuildFrustumFn     g_orig_build_frustum      = nullptr;
+inline BuildBatchCullerFn g_orig_build_batch_culler = nullptr;
+
+inline std::atomic<uint64_t> g_main_frustum_calls {0};
+inline std::atomic<uint64_t> g_batch_culler_calls {0};
+inline std::atomic<uint64_t> g_camera_frustum_calls {0};

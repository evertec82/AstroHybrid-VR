diff --git a/tools/pgo/vr-renderer.cmake b/tools/pgo/vr-renderer.cmake
new file mode 100644
index 00000000..6b95a54f
--- /dev/null
+++ b/tools/pgo/vr-renderer.cmake
@@ -0,0 +1,28 @@
+# The hybrid host loads the renderer as a DLL. Profile the DLL's C++ code independently.
+option(ASTROHYBRID_COLLECT_RENDERER_PROFILE "Record execution counts in the VR renderer" OFF)
+set(ASTROHYBRID_RENDERER_PROFILE "" CACHE FILEPATH "LLVM instrumentation profile for the VR renderer")
+if(ASTROHYBRID_COLLECT_RENDERER_PROFILE OR ASTROHYBRID_RENDERER_PROFILE)
+	if(NOT KYTY_CLANG_CL)
+		message(FATAL_ERROR "VR renderer profiling requires clang-cl")
+	endif()
+	if(KYTY_PGO_GENERATE OR KYTY_PGO_USE OR (ASTROHYBRID_COLLECT_RENDERER_PROFILE AND ASTROHYBRID_RENDERER_PROFILE))
+		message(FATAL_ERROR "Select a single PGO mode for the renderer")
+	endif()
+	if(ASTROHYBRID_COLLECT_RENDERER_PROFILE)
+		cmake_path(GET CMAKE_CXX_COMPILER PARENT_PATH llvm_bin)
+		file(GLOB profile_lib "${llvm_bin}/../lib/clang/*/lib/windows/clang_rt.profile-x86_64.lib")
+		if(NOT profile_lib)
+			message(FATAL_ERROR "LLVM's instrumentation runtime was not found alongside clang-cl")
+		endif()
+		list(GET profile_lib 0 runtime)
+		target_compile_options(kyty_emulator PRIVATE -fprofile-instr-generate)
+		set_property(SOURCE "${KYTY_SOURCE_DIR}/graphics/presentation/openxrHeadset.cpp" APPEND PROPERTY
+			COMPILE_DEFINITIONS "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,kyty_emulator>:KYTY_VR_PROFILE_CAPTURE>")
+		target_link_libraries(kyty_emulator "${runtime}")
+	else()
+		if(NOT EXISTS "${ASTROHYBRID_RENDERER_PROFILE}")
+			message(FATAL_ERROR "Missing VR renderer profile: ${ASTROHYBRID_RENDERER_PROFILE}")
+		endif()
+		target_compile_options(kyty_emulator PRIVATE "-fprofile-instr-use=${ASTROHYBRID_RENDERER_PROFILE}")
+	endif()
+endif()
